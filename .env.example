# Copy this file to `.env` and fill in your own values. Never commit `.env`.
# docker compose reads `.env` automatically.

# --- AI backend (OpenAI-compatible) ---
# Any OpenAI-compatible endpoint works (auto-detected by the plugin):
#   - ModelScope (free): https://api-inference.modelscope.ai/v1/chat/completions
#   - OpenAI / Groq / OpenRouter / Pioneer
AI_KEY=
AI_URL=https://api-inference.modelscope.ai/v1/chat/completions
AI_MODEL=Qwen/Qwen3-Next-80B-A3B-Instruct

# --- Optional: database credentials (defaults shown) ---
# DB_ROOT_PASSWORD=
# DB_PASSWORD=wordpress
